      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "tool_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "scope": {
      "type": "object"
    },
    "scope_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "transport_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "provenance_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "clock_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "revocation_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "revocation_epoch": {
