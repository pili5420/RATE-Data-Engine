{
  "realm": "RUNNER_ONLY_NOT_TARGET_HOST_EVIDENCE",
  "fixed_CIM_namespace": "ROOT/CIMV2",
  "fixed_CIM_classes": {
    "computer": {
      "class": "Win32_ComputerSystem",
      "fields": [
        "Name",
        "AutomaticManagedPagefile"
      ],
      "provider": "CIMWin32"
    },
    "boot": {
      "class": "Win32_OperatingSystem",
      "fields": [
        "CSName",
        "LastBootUpTime",
        "Version",
        "BuildNumber"
      ],
      "provider": "CIMWin32"
    },
    "product": {
      "class": "Win32_ComputerSystemProduct",
      "fields": [
        "UUID"
      ],
      "provider": "CIMWin32"
    },
    "volumes": {
      "class": "Win32_Volume",
      "fields": [
        "DeviceID",
        "DriveLetter",
        "SerialNumber"
      ],
      "provider": "MS_VOLUME"
    },
    "settings": {
      "class": "Win32_PageFileSetting",
      "fields": [
        "Name",
        "InitialSize",
        "MaximumSize"
      ],
      "provider": "CIMWin32"
    },
    "usage": {
      "class": "Win32_PageFileUsage",
      "fields": [
        "Name",
        "AllocatedBaseSize",
        "CurrentUsage",
        "PeakUsage",
        "TempPageFile"
      ],
      "provider": "CIMWin32"
    }
  },
  "allowed_query_commands": [
    "CimCmdlets\\Get-CimInstance with exact ClassName/Property/Namespace/OperationTimeoutSec5/ErrorActionStop",
    "CimCmdlets\\Get-CimClass with fixedsameclass/namespace,Providerqualifier only",
    "Registry64 LocalMachine OpenSubKey exact MemoryManagement,false;GetValueKind/GetValue PagingFiles DoNotExpandEnvironmentNames"
  ],
  "forbidden": [
    "Set/New/Remove-CimInstance",
    "Invoke-CimMethod",
    "Set/New-ItemProperty",
    "reg add/delete",
    "remote CIM including InputObject",
    "dynamic Command/ScriptBlock/nativeGUI activation",
    "Pagefile mutation",
    "Restart/OSconfiguration",
    "Production/HALT changes",
    "formalPermit issuance/consumption",
    "No-Auto-Next removal"
  ],
  "bounds": {
    "query_records": 11,
    "CIM_instances_per_query": 64,
    "Registry_strings": 32,
    "string_characters": 512,
    "raw_query_bytes": 98304,
    "provider_response_timeout_seconds": 5,
    "per_query_claimed_elapsed_ms": 10000,
    "per_query_wall_interval_seconds": 10,
    "collection_total_seconds": 120,
    "CI_job_minutes": 5
  },
  "timeout_limit": "Bounds checked after provider returns. Whole hosted job deadline bounds job participation but does not prove native provider cancellation. No target-runtime guarantee.",
  "output": "Fresh fixed RUNNER_TEMP/rate-pagefile-nongui-<runid>-<attempt>;CreateNew intent and evidence files,refuse existing output,no cleanup/retry/resume. Physical ACL/handle-race/powerloss notqualified.",
  "guard_limit": "Environment variables are spoofable accidentguards,not host attestation or a livePermit. StaticAST+exacthead review is not a hostile PowerShell sandbox. No currenthost query executed."
}
